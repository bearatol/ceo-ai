{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEO AI memory record",
  "type": "object",
  "required": [
    "title",
    "summary",
    "applies_when",
    "avoid_when",
    "evidence",
    "source",
    "id",
    "kind",
    "verified_on",
    "review_after",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "applies_when": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "avoid_when": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "kind": {
      "enum": [
        "lesson",
        "pattern",
        "preference"
      ]
    },
    "verified_on": {
      "type": "string",
      "format": "date"
    },
    "review_after": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$"
      }
    },
    "pattern": {
      "type": "object",
      "required": [
        "tokens",
        "components",
        "responsive",
        "accessibility",
        "example"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "object"
        },
        "components": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "responsive": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "accessibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "example": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "pattern"
      }
    }
  },
  "then": {
    "required": [
      "pattern"
    ]
  },
  "else": {
    "not": {
      "required": [
        "pattern"
      ]
    }
  }
}
