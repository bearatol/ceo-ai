{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bearatol/.agents/task.schema.json",
  "title": ".agents Task Packet",
  "type": "object",
  "required": ["schema_version", "task_id", "title", "objective", "assigned_agent", "scope", "permissions", "acceptance_criteria", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "assigned_agent": {"type": "string", "pattern": "^agent:[a-z0-9-]+$"},
    "scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "authoritative_inputs": {"type": "array", "items": {"type": "string"}},
    "excluded_context": {"type": "array", "items": {"type": "string"}},
    "context_budget": {"type": "string", "minLength": 1},
    "recommended_skills": {"type": "array", "items": {"type": "string", "pattern": "^skill:[a-z0-9-]+$"}, "uniqueItems": true},
    "permissions": {"enum": ["read-only", "workspace-write"]},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "status": {"enum": ["ready", "running", "review", "complete", "blocked"]}
  },
  "additionalProperties": false
}
